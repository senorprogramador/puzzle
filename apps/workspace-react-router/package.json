{
  "name": "workspace-react-router",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vite build --ssr src/entry.server.tsx --outDir dist/server",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test:rendering": "node --test tests/rendering.test.mjs"
  },
  "dependencies": {
    "@puzzle-ui/i18n": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
