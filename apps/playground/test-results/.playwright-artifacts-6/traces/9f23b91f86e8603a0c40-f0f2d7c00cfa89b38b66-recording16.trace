{"type":"before","callId":"sqsg@1085","startTime":46430.177,"class":"Frame","method":"evaluateExpression","params":{"expression":"async () => {\n    await document.fonts.ready;\n    const failedFonts = [...document.fonts].filter(font => font.status === \"error\").map(font => ({\n      family: font.family,\n      style: font.style,\n      weight: font.weight\n    }));\n    const failedImages = await Promise.all([...document.images].map(async image => {\n      image.loading = \"eager\";\n      try {\n        await image.decode();\n      } catch (error) {\n        return {\n          src: image.currentSrc || image.src,\n          error: error instanceof Error ? error.message : String(error)\n        };\n      }\n      if (!image.complete || image.naturalWidth === 0) {\n        return {\n          src: image.currentSrc || image.src,\n          error: \"Image is incomplete.\"\n        };\n      }\n      return null;\n    }));\n    await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));\n    return {\n      fontSetStatus: document.fonts.status,\n      failedFonts,\n      failedImages: failedImages.filter(Boolean)\n    };\n  }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}}}
