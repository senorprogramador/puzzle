{
  "name": "@puzzle-ui/site",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "homepage": "https://puzzle-ui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senorprogramador/puzzle.git"
  },
  "scripts": {
    "dev": "bun run fonts:download && vite dev",
    "build": "bun run fonts:download && vite build",
    "start": "node .output/server/index.mjs",
    "fonts:download": "bun ../../packages/theme/src/cli.ts fonts download --config src/puzzle-fonts.json --subsets latin,latin-ext",
    "test:seo": "bun test src/lib/seo.test.ts src/lib/homepage.test.ts src/lib/mdx-to-markdown.test.ts src/lib/seo-routes.test.ts src/lib/faq.test.ts src/lib/search-intents.test.ts",
    "test:sitemap": "bun test src/lib/seo-routes.test.ts",
    "test:seo:smoke": "bun scripts/validate-seo-endpoints.ts",
    "test:catalog": "bun test src/components/component-catalog.test.ts",
    "test:mdx": "bun test src/lib/mdx-imports.test.ts src/lib/pieces-docs.test.ts src/lib/package-overviews.test.ts",
    "test:tutorials": "bun scripts/validate-tutorials.ts",
    "test:hydration": "bun scripts/validate-hydration.ts",
    "test:theme-studio": "bun test src/components/theme-studio/theme-studio-model.test.ts",
    "test:homepage:theme": "bun scripts/validate-homepage-theme.ts",
    "test:preview-layout": "bun scripts/validate-preview-layout.ts",
    "validate:seo": "bun run test:seo && bun run test:catalog && bun run test:mdx && bun run test:tutorials && bun run typecheck && bun run build && bun run test:homepage:theme && bun run test:hydration && bun run test:seo:smoke",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@puzzle-ui/core": "workspace:*",
    "@puzzle-ui/hooks": "workspace:*",
    "@puzzle-ui/icons": "workspace:*",
    "@puzzle-ui/pieces": "workspace:*",
    "@puzzle-ui/seo": "workspace:*",
    "@puzzle-ui/theme": "workspace:*",
    "@puzzle-ui/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/router-core": "1.171.39",
    "@types/mdx": "^2.0.14",
    "fumadocs-core": "^16.17.10",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-ui": "^16.17.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "nitro": "^3.0.261103-rc",
    "vite": "^8.3.3"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
