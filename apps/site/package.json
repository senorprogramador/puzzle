{
  "name": "@puzzle-ui/site",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run fonts:download && vite dev",
    "build": "bun run fonts:download && vite build",
    "start": "node .output/server/index.mjs",
    "fonts:download": "bun ../../packages/theme/src/cli.ts fonts download --config src/puzzle-fonts.json --subsets latin,latin-ext",
    "test:sitemap": "bun test src/lib/sitemap.test.ts",
    "test:catalog": "bun test src/components/component-catalog.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@puzzle-ui/core": "workspace:*",
    "@puzzle-ui/hooks": "workspace:*",
    "@puzzle-ui/icons": "workspace:*",
    "@puzzle-ui/theme": "workspace:*",
    "@puzzle-ui/pieces": "workspace:*",
    "@puzzle-ui/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@types/mdx": "^2.0.14",
    "fumadocs-core": "^16.17.10",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-ui": "^16.17.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "nitro": "^3.0.261103-rc",
    "vite": "^8.3.3"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
