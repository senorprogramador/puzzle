{
  "name": "@puzzle/ui",
  "version": "0.1.0",
  "description": "UI components for Puzzle",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "vitest": "bunx vitest run --project unit --project component",
    "test:unit": "bunx vitest run --project unit",
    "test:component": "bunx vitest run --project component",
    "test:browser": "bunx vitest run --project browser",
    "test:all": "bunx vitest run",
    "vitest:watch": "bunx vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@puzzle/core": "workspace:*",
    "@puzzle/hooks": "workspace:*",
    "@puzzle/icons": "workspace:*",
    "@puzzle/theme": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@tsdown/css": "^0.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser-playwright": "^5.1.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.65.0",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "latest"
  }
}
