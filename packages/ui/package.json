{
  "name": "@puzzle-ui/ui",
  "version": "0.20.0",
  "description": "Composable React UI components with typed APIs for Puzzle applications",
  "homepage": "https://puzzle-ui.com/docs/ui",
  "keywords": [
    "puzzle-ui",
    "react",
    "typescript",
    "ui-components",
    "component-library",
    "design-system",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senorprogramador/puzzle.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./rendering/deferred": {
      "import": {
        "types": "./dist/components/utilities/rendering/deferred.d.ts",
        "default": "./dist/components/utilities/rendering/deferred.js"
      },
      "require": {
        "types": "./dist/components/utilities/rendering/deferred.d.cts",
        "default": "./dist/components/utilities/rendering/deferred.cjs"
      }
    },
    "./rendering/ssr": {
      "import": {
        "types": "./dist/components/utilities/rendering/ssr.d.ts",
        "default": "./dist/components/utilities/rendering/ssr.js"
      },
      "require": {
        "types": "./dist/components/utilities/rendering/ssr.d.cts",
        "default": "./dist/components/utilities/rendering/ssr.cjs"
      }
    },
    "./rendering/static": {
      "import": {
        "types": "./dist/components/utilities/rendering/static.d.ts",
        "default": "./dist/components/utilities/rendering/static.js"
      },
      "require": {
        "types": "./dist/components/utilities/rendering/static.d.cts",
        "default": "./dist/components/utilities/rendering/static.cjs"
      }
    },
    "./rendering/fold": {
      "import": {
        "types": "./dist/components/utilities/rendering/fold.d.ts",
        "default": "./dist/components/utilities/rendering/fold.js"
      },
      "require": {
        "types": "./dist/components/utilities/rendering/fold.d.cts",
        "default": "./dist/components/utilities/rendering/fold.cjs"
      }
    },
    "./next/client": {
      "import": {
        "types": "./dist/components/utilities/rendering/next/client.d.ts",
        "default": "./dist/components/utilities/rendering/next/client.js"
      },
      "require": {
        "types": "./dist/components/utilities/rendering/next/client.d.cts",
        "default": "./dist/components/utilities/rendering/next/client.cjs"
      }
    },
    "./next/server": {
      "import": {
        "types": "./dist/components/utilities/rendering/next/server.d.ts",
        "default": "./dist/components/utilities/rendering/next/server.js"
      },
      "require": {
        "types": "./dist/components/utilities/rendering/next/server.d.cts",
        "default": "./dist/components/utilities/rendering/next/server.cjs"
      }
    },
    "./tanstack/client": {
      "import": {
        "types": "./dist/components/utilities/rendering/tanstack/client.d.ts",
        "default": "./dist/components/utilities/rendering/tanstack/client.js"
      },
      "require": {
        "types": "./dist/components/utilities/rendering/tanstack/client.d.cts",
        "default": "./dist/components/utilities/rendering/tanstack/client.cjs"
      }
    },
    "./tanstack/server": {
      "import": {
        "types": "./dist/components/utilities/rendering/tanstack/server.d.ts",
        "default": "./dist/components/utilities/rendering/tanstack/server.js"
      },
      "require": {
        "types": "./dist/components/utilities/rendering/tanstack/server.d.cts",
        "default": "./dist/components/utilities/rendering/tanstack/server.cjs"
      }
    },
    "./tanstack/shared": {
      "import": {
        "types": "./dist/components/utilities/rendering/tanstack/shared.d.ts",
        "default": "./dist/components/utilities/rendering/tanstack/shared.js"
      },
      "require": {
        "types": "./dist/components/utilities/rendering/tanstack/shared.d.cts",
        "default": "./dist/components/utilities/rendering/tanstack/shared.cjs"
      }
    }
  },
  "files": [
    "dist",
    "ai"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p .",
    "vitest": "bunx vitest run --project unit --project component",
    "test:unit": "bunx vitest run --project unit",
    "test:component": "bunx vitest run --project component",
    "test:browser": "bunx vitest run --project browser",
    "test:all": "bunx vitest run && bun run test:streaming",
    "test:streaming": "bun test src/components/utilities/rendering/rendering-stream.test.mjs",
    "vitest:watch": "bunx vitest run --watch --passWithNoTests",
    "clean": "rm -rf dist",
    "prepack": "tsdown"
  },
  "dependencies": {
    "@puzzle-ui/core": "^0.20.0",
    "@puzzle-ui/hooks": "^0.20.0",
    "@puzzle-ui/icons": "^0.20.0",
    "@puzzle-ui/media": "^0.20.0",
    "@puzzle-ui/theme": "^0.20.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@tsdown/css": "^0.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser-playwright": "^5.1.0",
    "jsdom": "^26.1.0",
    "playwright": "1.65.1",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "5.1.1"
  }
}
