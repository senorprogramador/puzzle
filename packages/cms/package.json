{
  "name": "@puzzle-ui/cms",
  "version": "0.21.0",
  "description": "Framework-neutral content schemas, entries, revisions, and publishing services for Puzzle.",
  "homepage": "https://puzzle-ui.com/docs/cms",
  "keywords": [
    "puzzle-ui",
    "cms",
    "content-management",
    "publishing",
    "headless-cms"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senorprogramador/puzzle.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "ai"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "vitest": "bun test",
    "clean": "rm -rf dist",
    "prepack": "tsdown"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "bun": "^1.4.4",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@puzzle-ui/storage": "^0.21.0"
  }
}
