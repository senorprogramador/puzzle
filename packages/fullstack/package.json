{
  "name": "@puzzle-ui/fullstack",
  "version": "0.14.0",
  "description": "Browser Auth, Media, and CMS clients, server handlers, and Next.js and TanStack Start adapters for Puzzle.",
  "homepage": "https://puzzle-ui.com/docs/fullstack",
  "keywords": [
    "puzzle-ui",
    "authentication",
    "media",
    "cms",
    "uploads",
    "react",
    "nextjs",
    "tanstack-start",
    "server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senorprogramador/puzzle.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    "./cms/shared": {
      "import": {
        "types": "./dist/cms/shared/index.d.ts",
        "default": "./dist/cms/shared/index.js"
      },
      "require": {
        "types": "./dist/cms/shared/index.d.cts",
        "default": "./dist/cms/shared/index.cjs"
      }
    },
    "./cms/server": {
      "import": {
        "types": "./dist/cms/server/index.d.ts",
        "default": "./dist/cms/server/index.js"
      },
      "require": {
        "types": "./dist/cms/server/index.d.cts",
        "default": "./dist/cms/server/index.cjs"
      }
    },
    "./cms/client": {
      "import": {
        "types": "./dist/cms/client/index.d.ts",
        "default": "./dist/cms/client/index.js"
      },
      "require": {
        "types": "./dist/cms/client/index.d.cts",
        "default": "./dist/cms/client/index.cjs"
      }
    },
    "./cms/next": {
      "import": {
        "types": "./dist/cms/next/index.d.ts",
        "default": "./dist/cms/next/index.js"
      },
      "require": {
        "types": "./dist/cms/next/index.d.cts",
        "default": "./dist/cms/next/index.cjs"
      }
    },
    "./cms/tanstack": {
      "import": {
        "types": "./dist/cms/tanstack/index.d.ts",
        "default": "./dist/cms/tanstack/index.js"
      },
      "require": {
        "types": "./dist/cms/tanstack/index.d.cts",
        "default": "./dist/cms/tanstack/index.cjs"
      }
    },
    "./media/shared": {
      "import": {
        "types": "./dist/media/shared/index.d.ts",
