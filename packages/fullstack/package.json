{
  "name": "@puzzle-ui/fullstack",
  "version": "0.6.0",
  "description": "First-party Puzzle Auth client, server and framework integration entry points.",
  "homepage": "https://puzzle-ui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senorprogramador/puzzle.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    "./auth/client": {
      "import": {
        "types": "./dist/auth/client/index.d.ts",
        "default": "./dist/auth/client/index.js"
      },
      "require": {
        "types": "./dist/auth/client/index.d.cts",
        "default": "./dist/auth/client/index.cjs"
      }
    },
    "./auth/server": {
      "import": {
        "types": "./dist/auth/server/index.d.ts",
        "default": "./dist/auth/server/index.js"
      },
      "require": {
        "types": "./dist/auth/server/index.d.cts",
        "default": "./dist/auth/server/index.cjs"
      }
    },
    "./auth/shared": {
      "import": {
        "types": "./dist/auth/shared/index.d.ts",
        "default": "./dist/auth/shared/index.js"
      },
      "require": {
        "types": "./dist/auth/shared/index.d.cts",
        "default": "./dist/auth/shared/index.cjs"
      }
    },
    "./auth/next": {
      "import": {
        "types": "./dist/auth/next/index.d.ts",
        "default": "./dist/auth/next/index.js"
      },
      "require": {
        "types": "./dist/auth/next/index.d.cts",
        "default": "./dist/auth/next/index.cjs"
      }
    },
    "./auth/tanstack": {
      "import": {
        "types": "./dist/auth/tanstack/index.d.ts",
        "default": "./dist/auth/tanstack/index.js"
      },
      "require": {
        "types": "./dist/auth/tanstack/index.d.cts",
        "default": "./dist/auth/tanstack/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import ./tests/setup.mjs --test",
    "vitest": "node --import ./tests/setup.mjs --test && vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.config.ts",
    "clean": "rm -rf dist",
    "prepack": "tsdown"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.65.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "latest"
  },
  "dependencies": {
    "@puzzle-ui/ui": "^0.6.0",
    "@puzzle-ui/auth": "^0.6.0",
    "@puzzle-ui/session": "^0.6.0",
    "@simplewebauthn/browser": "^14.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next": "^15.0.0 || ^16.0.0",
    "@tanstack/react-start": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "@tanstack/react-start": {
      "optional": true
    }
  }
}
