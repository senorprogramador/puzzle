  "files": [
    "dist",
    "ai"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --experimental-strip-types --import ./tests/setup.mjs --test",
    "test:e2e:frameworks": "node --test e2e/frameworks.e2e.mjs",
    "vitest": "node --experimental-strip-types --import ./tests/setup.mjs --test && vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.config.ts",
    "clean": "rm -rf dist",
    "prepack": "tsdown"
  },
  "devDependencies": {
    "@puzzle-ui/storage": "^0.14.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "1.65.1",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@puzzle-ui/cms": "^0.14.0",
    "@puzzle-ui/ui": "^0.14.0",
    "@puzzle-ui/auth": "^0.14.0",
    "@puzzle-ui/media": "^0.14.0",
    "@puzzle-ui/session": "^0.14.0",
    "@simplewebauthn/browser": "^14.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next": "^15.0.0 || ^16.0.0",
    "@tanstack/react-start": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "@tanstack/react-start": {
      "optional": true
    }
  }
}
