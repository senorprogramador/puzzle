{
  "name": "@puzzle-ui/storage-mongodb",
  "version": "0.5.1",
  "description": "MongoDB storage adapter foundation for Puzzle Auth.",
  "homepage": "https://puzzle-ui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senorprogramador/puzzle.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p .",
    "test": "bash scripts/test-with-mongodb.sh",
    "vitest": "bash scripts/test-with-mongodb.sh",
    "clean": "rm -rf dist",
    "prepack": "tsdown"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "bun": "^1.4.4",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@puzzle-ui/storage": "^0.5.1",
    "mongodb": "^7.8.0"
  }
}
