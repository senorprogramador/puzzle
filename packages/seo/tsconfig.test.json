{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "types": [
            "node",
            "react"
        ]
    },
    "include": [
        "src/**/*.ts",
        "src/tests/**/*.ts",
        "src/**/*.tsx"
    ],
