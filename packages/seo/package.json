{
  "name": "@puzzle-ui/seo",
  "version": "0.4.0",
  "description": "Framework-independent SEO and structured data toolkit for Puzzle.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./context": {
      "import": {
        "types": "./dist/context/index.d.ts",
        "default": "./dist/context/index.js"
      },
      "require": {
        "types": "./dist/context/index.d.cts",
        "default": "./dist/context/index.cjs"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema/index.d.ts",
        "default": "./dist/schema/index.js"
      },
      "require": {
        "types": "./dist/schema/index.d.cts",
        "default": "./dist/schema/index.cjs"
      }
    },
    "./metadata": {
      "import": {
        "types": "./dist/metadata/index.d.ts",
        "default": "./dist/metadata/index.js"
      },
      "require": {
        "types": "./dist/metadata/index.d.cts",
        "default": "./dist/metadata/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./sitemap": {
      "import": {
        "types": "./dist/sitemap/index.d.ts",
        "default": "./dist/sitemap/index.js"
      },
      "require": {
        "types": "./dist/sitemap/index.d.cts",
        "default": "./dist/sitemap/index.cjs"
      }
    },
    "./robots": {
      "import": {
        "types": "./dist/robots/index.d.ts",
        "default": "./dist/robots/index.js"
      },
      "require": {
        "types": "./dist/robots/index.d.cts",
        "default": "./dist/robots/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./validation": {
      "import": {
        "types": "./dist/validation/index.d.ts",
        "default": "./dist/validation/index.js"
      },
      "require": {
        "types": "./dist/validation/index.d.cts",
        "default": "./dist/validation/index.cjs"
      }
    },
    "./urls": {
      "import": {
        "types": "./dist/urls/index.d.ts",
        "default": "./dist/urls/index.js"
      },
      "require": {
        "types": "./dist/urls/index.d.cts",
        "default": "./dist/urls/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next/index.d.ts",
        "default": "./dist/next/index.js"
      },
      "require": {
        "types": "./dist/next/index.d.cts",
        "default": "./dist/next/index.cjs"
      }
    },
    "./tanstack": {
      "import": {
        "types": "./dist/tanstack/index.d.ts",
        "default": "./dist/tanstack/index.js"
      },
      "require": {
        "types": "./dist/tanstack/index.d.cts",
        "default": "./dist/tanstack/index.cjs"
      }
    },
    "./react-router": {
      "import": {
        "types": "./dist/react-router/index.d.ts",
        "default": "./dist/react-router/index.js"
      },
      "require": {
        "types": "./dist/react-router/index.d.cts",
        "default": "./dist/react-router/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "schema:generate": "node scripts/generate-schemaorg.mjs",
    "schema:check": "node scripts/generate-schemaorg.mjs --check",
    "build": "bun run schema:check && tsdown",
    "typecheck": "tsc --noEmit -p .",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "vitest": "bun run test:integration && bun run test:unit && bun run test:schema",
    "test:unit": "vitest run src/tests/*.test.ts src/tests/*.test.tsx --exclude src/tests/public-api.test.ts",
    "test:integration": "bun run build && node --test src/tests/*.test.mjs",
    "test:boundaries": "node --test src/tests/boundaries.test.mjs",
    "test:package": "bun run build && node --test src/tests/package.test.mjs",
    "test:schema": "bun run typecheck:test",
    "clean": "rm -rf dist",
    "prepack": "bun run schema:check && tsdown"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "latest"
  }
}
