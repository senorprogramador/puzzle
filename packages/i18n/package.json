{
  "name": "@puzzle-ui/i18n",
  "version": "0.16.0",
  "description": "Type-safe, SSR-safe internationalization primitives for React applications.",
  "homepage": "https://puzzle-ui.com/docs/multilingual",
  "keywords": [
    "puzzle-ui",
    "i18n",
    "internationalization",
    "localization",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senorprogramador/puzzle.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "puzzle-i18n": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./routing": {
      "import": {
        "types": "./dist/routing/index.d.ts",
        "default": "./dist/routing/index.js"
      },
      "require": {
        "types": "./dist/routing/index.d.cts",
        "default": "./dist/routing/index.cjs"
      }
    },
    "./seo": {
      "import": {
        "types": "./dist/seo/index.d.ts",
        "default": "./dist/seo/index.js"
      },
      "require": {
        "types": "./dist/seo/index.d.cts",
        "default": "./dist/seo/index.cjs"
      }
    },
    "./seo/sitemap": {
      "import": {
        "types": "./dist/seo/sitemap.d.ts",
        "default": "./dist/seo/sitemap.js"
      },
      "require": {
        "types": "./dist/seo/sitemap.d.cts",
        "default": "./dist/seo/sitemap.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./compiler": {
      "import": {
        "types": "./dist/compiler/index.d.ts",
        "default": "./dist/compiler/index.js"
      },
      "require": {
        "types": "./dist/compiler/index.d.cts",
        "default": "./dist/compiler/index.cjs"
      }
    },
    "./compiler/typescript": {
      "import": {
        "types": "./dist/compiler/typescript.d.ts",
        "default": "./dist/compiler/typescript.js"
      },
      "require": {
        "types": "./dist/compiler/typescript.d.cts",
        "default": "./dist/compiler/typescript.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/compiler/vite.d.ts",
