      "require": {
        "types": "./dist/ai/index.d.cts",
        "default": "./dist/ai/index.cjs"
      }
    },
    "./sources": {
      "import": {
        "types": "./dist/sources/index.d.ts",
        "default": "./dist/sources/index.js"
      },
      "require": {
        "types": "./dist/sources/index.d.cts",
        "default": "./dist/sources/index.cjs"
      }
    },
    "./sources/node": {
      "import": {
        "types": "./dist/sources/node.d.ts",
