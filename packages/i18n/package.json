        "types": "./dist/adapters/next.d.cts",
        "default": "./dist/adapters/next.cjs"
      }
    },
    "./tanstack": {
      "import": {
        "types": "./dist/adapters/tanstack.d.ts",
        "default": "./dist/adapters/tanstack.js"
      },
      "require": {
        "types": "./dist/adapters/tanstack.d.cts",
        "default": "./dist/adapters/tanstack.cjs"
      }
    },
    "./react-router": {
      "import": {
        "types": "./dist/adapters/react-router.d.ts",
        "default": "./dist/adapters/react-router.js"
      },
      "require": {
        "types": "./dist/adapters/react-router.d.cts",
