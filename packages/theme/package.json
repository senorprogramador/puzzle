{
  "name": "@puzzle-ui/theme",
  "version": "0.4.0",
  "description": "Theme components for Puzzle",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./components-context": {
      "import": {
        "types": "./dist/components-context.d.ts",
        "default": "./dist/components-context.js"
      },
      "require": {
        "types": "./dist/components-context.d.cts",
        "default": "./dist/components-context.cjs"
      }
    },
    "./scope-context": {
      "import": {
        "types": "./dist/scope-context.d.ts",
        "default": "./dist/scope-context.js"
      },
      "require": {
        "types": "./dist/scope-context.d.cts",
        "default": "./dist/scope-context.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p .",
    "vitest": "bunx vitest run",
    "vitest:watch": "bunx vitest run --watch --passWithNoTests",
    "clean": "rm -rf dist",
    "prepack": "tsdown"
  },
  "dependencies": {
    "@puzzle-ui/core": "^0.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tsdown/css": "^0.23.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "latest"
  }
}
