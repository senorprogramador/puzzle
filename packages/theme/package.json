{
  "name": "@puzzle/theme",
  "version": "0.1.0",
  "description": "Theme components for Puzzle",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./components-context": {
      "import": "./dist/components-context.js",
      "require": "./dist/components-context.cjs"
    },
    "./scope-context": {
      "import": "./dist/scope-context.js",
      "require": "./dist/scope-context.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "vitest": "bunx vitest run",
    "vitest:watch": "bunx vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@puzzle/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tsdown/css": "^0.23.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "latest"
  }
}
