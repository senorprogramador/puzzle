{
    "compilerOptions": {
        "target": "ES2022",
        "types": ["node"],
        "lib": [
            "ES2022",
            "DOM"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "declaration": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "paths": {
            "@puzzle-ui/core": [
                "../core/src/index.ts"
            ],
            "@puzzle-ui/core/*": [
                "../core/src/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}