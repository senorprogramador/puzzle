{
  "name": "@puzzle-ui/core",
  "version": "0.4.0",
  "description": "Framework-independent utilities",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p .",
    "prepack": "tsdown",
    "vitest": "bunx vitest run --passWithNoTests",
    "vitest:watch": "bunx vitest run --watch --passWithNoTests"
  },
  "devDependencies": {
    "tsdown": "^0.23.1",
    "tsup": "latest",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
