{
  "name": "@puzzle-ui/auth",
  "version": "0.5.0",
  "description": "Framework-independent authentication core for Puzzle.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test",
    "vitest": "node --test",
    "clean": "rm -rf dist",
    "prepack": "tsdown"
  },
  "devDependencies": {
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@puzzle-ui/storage": "^0.5.0",
    "@puzzle-ui/session": "^0.5.0",
    "@simplewebauthn/server": "^14.1.0"
  }
}
