{
  "name": "@puzzle-ui/hooks",
  "version": "0.12.0",
  "description": "Reusable interaction and rendering hooks for React applications",
  "homepage": "https://puzzle-ui.com/docs/hooks",
  "keywords": [
    "puzzle-ui",
    "react",
    "typescript",
    "react-hooks",
    "visibility",
    "rendering",
    "keyboard-shortcuts",
    "roving-focus"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senorprogramador/puzzle.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "ai"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p .",
    "vitest": "bunx vitest run --passWithNoTests",
    "clean": "rm -rf dist",
    "prepack": "tsdown"
  },
  "dependencies": {
    "@puzzle-ui/core": "^0.12.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-test-renderer": "^19.0.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
