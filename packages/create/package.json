{
  "name": "@puzzle-ui/create",
  "version": "0.10.0",
  "description": "CLI for scaffolding Puzzle React applications with Next.js, TanStack Start, or Vite.",
  "homepage": "https://puzzle-ui.com/docs/create",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senorprogramador/puzzle.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-puzzle": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "puzzle-ui",
    "react",
    "typescript",
    "nextjs",
    "tanstack-start",
    "vite",
    "create",
    "scaffolding",
    "cli"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p e2e",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:watch": "bunx vitest run --watch --passWithNoTests",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
