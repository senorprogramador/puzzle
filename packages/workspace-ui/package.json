{
  "name": "@puzzle-ui/workspace-ui",
  "private": true,
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test"
  },
  "dependencies": {
    "@puzzle-ui/fullstack": "workspace:*",
    "@puzzle-ui/pieces": "workspace:*",
    "@puzzle-ui/ui": "workspace:*",
    "@puzzle-ui/workspace": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun": "^1.4.4",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  }
}
