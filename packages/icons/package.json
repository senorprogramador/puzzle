{
  "name": "@puzzle-ui/icons",
  "version": "0.10.0",
  "description": "Iconify-powered React SVG icons for Puzzle applications",
  "homepage": "https://puzzle-ui.com/docs/icons",
  "keywords": [
    "puzzle-ui",
    "react",
    "icons",
    "iconify",
    "svg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senorprogramador/puzzle.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p .",
    "vitest": "bunx vitest run --passWithNoTests",
    "vitest:watch": "bunx vitest run --watch --passWithNoTests",
    "clean": "rm -rf dist",
    "prepack": "tsdown"
  },
  "dependencies": {
    "@iconify/react": "^6.0.3",
    "@iconify/utils": "^3.1.7",
    "@puzzle-ui/core": "^0.10.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "latest"
  }
}
