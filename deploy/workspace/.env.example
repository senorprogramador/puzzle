# Copy to .env.workspace in the repository root and keep it private.
# Set both origins to the exact public HTTPS origins, with no trailing slash.
WORKSPACE_NEXT_DOMAIN=next.example.com
WORKSPACE_NEXT_APP_ORIGIN=https://next.example.com
WORKSPACE_TANSTACK_DOMAIN=tanstack.example.com
WORKSPACE_TANSTACK_APP_ORIGIN=https://tanstack.example.com
LETSENCRYPT_EMAIL=ops@example.com
WEBPROXY_NETWORK=webproxy

# Use stable, alphanumeric usernames and distinct 64-character hex passwords.
MONGODB_ROOT_USERNAME=workspace_root
MONGODB_ROOT_PASSWORD=
MONGODB_NEXT_DATABASE=workspace_next
MONGODB_NEXT_APP_USERNAME=workspace_next_app
MONGODB_NEXT_APP_PASSWORD=
MONGODB_TANSTACK_DATABASE=workspace_tanstack
MONGODB_TANSTACK_APP_USERNAME=workspace_tanstack_app
MONGODB_TANSTACK_APP_PASSWORD=

# Each AUTH_ENCRYPTION_KEY_HEX is exactly 64 hex characters.
# Each AUTH_RATE_LIMIT_SECRET must contain at least 32 characters.
WORKSPACE_NEXT_AUTH_ENCRYPTION_KEY_HEX=
WORKSPACE_NEXT_AUTH_RATE_LIMIT_SECRET=
WORKSPACE_TANSTACK_AUTH_ENCRYPTION_KEY_HEX=
WORKSPACE_TANSTACK_AUTH_RATE_LIMIT_SECRET=

# Optional Resend settings enable verification, reset, and invitation email.
RESEND_API_KEY=
WORKSPACE_EMAIL_FROM=

# Optional only when the trusted proxy always overwrites the named header.
TRUSTED_CLIENT_IP_HEADER=
