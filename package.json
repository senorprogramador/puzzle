{
  "name": "puzzle-ui",
  "private": true,
  "scripts": {
    "site": "bun run --filter '@puzzle-ui/site' dev",
    "dev": "bun run --filter '@puzzle-ui/playground' dev",
    "schema:generate": "bun run --filter '@puzzle-ui/seo' schema:generate",
    "schema:check": "bun run --filter '@puzzle-ui/seo' schema:check",
    "build": "bun run schema:check && bun run --filter './packages/*' build",
    "typecheck": "bun run --filter './packages/*' --filter './apps/site' typecheck",
    "test:all": "bun run build && bun run --filter './packages/*' vitest && bun run --filter '@puzzle-ui/create' test && bun run --filter '@puzzle-ui/ui' test:browser && bun run --filter '@puzzle-ui/pieces' test:browser",
    "benchmark:auth": "bun run build && node scripts/benchmark-auth.mjs",
    "storybook": "bun run --filter './apps/playground' storybook",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run"
  },
  "workspaces": [
    "apps/playground",
    "apps/site",
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "bun": "^1.4.4",
    "tsdown": "^0.23.1"
  }
}
