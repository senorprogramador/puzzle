{
  "name": "puzzle-ui",
  "private": true,
  "scripts": {
    "site": "bun run --filter '@puzzle-ui/site' dev",
    "dev": "bun run --filter '@puzzle-ui/playground' dev",
    "build": "bun run --filter './packages/*' build",
    "vitest": "bun run --filter './packages/*' vitest",
    "storybook": "bun run --filter './apps/playground' storybook",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run"
  },
  "workspaces": [
    "apps/playground",
    "apps/site",
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "bun": "^1.4.4",
    "tsdown": "^0.23.1"
  }
}
