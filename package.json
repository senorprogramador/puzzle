{
  "name": "puzzle",
  "private": true,
  "scripts": {
    "site": "bun run --filter '@puzzle/site' dev",
    "dev": "bun run --filter '@puzzle/playground' dev",
    "build": "bun run --filter './packages/*' build",
    "test": "bun run --filter './packages/*' test",
    "storybook": "bun run --filter './apps/playground' storybook"
  },
  "workspaces": [
    "apps/playground",
    "apps/site",
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "bun": "^1.4.4",
    "tsdown": "^0.23.1"
  }
}
