{
  "name": "puzzle-ui",
  "private": true,
  "homepage": "https://puzzle-ui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senorprogramador/puzzle.git"
  },
  "scripts": {
    "site": "bun run --filter '@puzzle-ui/site' dev",
    "dev": "bun run --filter '@puzzle-ui/playground' dev",
    "fonts:download": "bun run --filter '@puzzle-ui/site' fonts:download",
    "schema:generate": "bun run --filter '@puzzle-ui/seo' schema:generate",
    "schema:check": "bun run --filter '@puzzle-ui/seo' schema:check",
    "build": "bun run schema:check && bun run --filter './packages/*' build",
    "typecheck": "bun run --filter './packages/*' --filter './apps/site' typecheck",
    "test:all": "bun run build && bun run --filter '!@puzzle-ui/storage-mongodb' vitest && bun run --filter '@puzzle-ui/create' test && bun run --filter '@puzzle-ui/ui' test:browser && bun run --filter '@puzzle-ui/pieces' test:browser && bun run --filter '@puzzle-ui/storage-mongodb' vitest",
    "benchmark:auth": "bun run build && node scripts/benchmark-auth.mjs",
    "benchmark:seo": "bun run build && bun run packages/seo/scripts/benchmark.ts",
    "storybook": "bun run --filter './apps/playground' storybook",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run",
    "test:release": "node --test scripts/release.test.mjs"
  },
  "workspaces": [
    "apps/playground",
    "apps/site",
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "bun": "^1.4.4",
    "playwright": "^1.65.0",
    "tsdown": "^0.23.1"
  }
}
